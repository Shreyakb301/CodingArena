CREATE TABLE chapterProgress (
    userId            TEXT    NOT NULL,
    chapterId         TEXT    NOT NULL,
    payloadJson       TEXT    NOT NULL,
    updatedAt         INTEGER NOT NULL,
    synced            INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (userId, chapterId)
);

CREATE INDEX chapterProgress_sync_idx ON chapterProgress(synced, updatedAt);

CREATE TABLE codeDraft (
    userId            TEXT    NOT NULL,
    problemId         TEXT    NOT NULL,
    language          TEXT    NOT NULL,
    sourceCode        TEXT    NOT NULL,
    updatedAt         INTEGER NOT NULL,
    synced            INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (userId, problemId, language)
);

CREATE INDEX codeDraft_sync_idx ON codeDraft(synced, updatedAt);
