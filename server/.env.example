PORT=8080
ARENA_DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/codingarena
ARENA_DATABASE_USER=codingarena
ARENA_DATABASE_PASSWORD=replace-me
ARENA_JWT_SECRET=replace-with-at-least-32-random-bytes
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_TOKEN=replace-with-the-private-runner-token

# Browser origins allowed to call the API (comma-separated). The web app.
ARENA_ALLOWED_ORIGINS=http://localhost:8080
# Where the browser app is served; OAuth sends the finished session back here.
ARENA_APP_URL=http://localhost:8080

# "Continue with Google" - all three required to enable it, otherwise the
# /v1/auth/google/* routes report 501. From Google Cloud -> APIs & Services ->
# Credentials -> OAuth 2.0 Client ID (type: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match an Authorized redirect URI on the OAuth client.
GOOGLE_REDIRECT_URI=http://localhost:8080/v1/auth/google/callback
